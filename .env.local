# SentinelBridge Configuration
# Copy this file to .env.local and update with your actual values

# ============== BLOCKCHAIN CONFIGURATION ==============

# Source Chain ID (e.g., 1 for Ethereum mainnet)
SOURCE_CHAIN_ID=1

# Destination Chain ID (e.g., 137 for Polygon)
DEST_CHAIN_ID=137

# SentinelBridge Contract Address
# Replace with your actual SentinelBridge contract address
NEXT_PUBLIC_BRIDGE_ADDRESS=0x9E29b188AC3194a6e056e9947C5bce9761f96BF0

# ============== RISK THRESHOLDS ==============

# Maximum allowed ratio of locked amount to source reserves (0.0 - 1.0)
# Default: 0.8 means 80% of source reserves can be locked
MAX_RISK_RATIO=0.8

# Emergency threshold absolute amount in wei
# Default: 1 token = 10^18 wei (assuming 18 decimals)
EMERGENCY_THRESHOLD=1000000000000000000

# ============== RPC ENDPOINTS ==============

# Source chain RPC endpoint
SOURCE_RPC=
# Destination chain RPC endpoint
DEST_RPC=
# ============== CHAINLINK CRE SETTINGS ==============
DEPLOYER_PRIVATE_KEY=
# CRE Environment (local, testnet, mainnet)
CRE_ENV=testnet

# Workflow polling interval in seconds
CHECK_INTERVAL=60

# ============== NEXT.JS API ==============

# API base URL for client-side requests
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ============== LOGGING ==============

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable structured JSON logging
JSON_LOGS=false

