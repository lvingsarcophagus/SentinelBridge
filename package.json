{
  "name": "sentinel-bridge-watchdog",
  "version": "1.0.0",
  "type": "module",
  "description": "SentinelBridge - Automated circuit breaker for cross-chain bridge liquidity monitoring using Chainlink CRE",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsc --project tsconfig.workflow.json",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "simulate": "cre workflow simulate ./dist/workflow.js",
    "simulate:scenario": "tsx scripts/simulate.ts",
    "simulate:normal": "tsx scripts/simulate.ts 1",
    "simulate:escalation": "tsx scripts/simulate.ts 2",
    "simulate:crisis": "tsx scripts/simulate.ts 3",
    "simulate:depletion": "tsx scripts/simulate.ts 4",
    "workflow:build": "tsc --project tsconfig.workflow.json",
    "workflow:watch": "tsc --project tsconfig.workflow.json --watch",
    "node:start": "hardhat node",
    "node:deploy": "hardhat run scripts/deploy-bridge.ts --network localhost",
    "demo:crisis": "hardhat run scripts/demo-crisis.ts --network localhost",
    "demo:normal": "hardhat run scripts/demo-normal.ts --network localhost",
    "demo:stealth": "hardhat run scripts/demo-stealth-drain.ts --network localhost",
    "demo:flash": "hardhat run scripts/demo-flash-loan.ts --network localhost",
    "demo:governance": "hardhat run scripts/demo-governance.ts --network localhost",
    "demo:oracle": "hardhat run scripts/demo-oracle.ts --network localhost",
    "demo:show": "hardhat run scripts/show-bridge-state.ts --network localhost"
  },
  "dependencies": {
    "@react-three/drei": "^9.115.0",
    "@react-three/fiber": "^9.0.0",
    "axios": "^1.7.0",
    "clsx": "^2.0.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "latest",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.183.1",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^8.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "ethers": "^6.16.0",
    "hardhat": "^3.1.11",
    "jest": "^29.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
