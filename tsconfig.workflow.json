{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./src/workflows/sentinel-bridge",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["src/workflows/sentinel-bridge/**/*.ts"],
  "exclude": ["node_modules", ".next", "app/**/*", "components/**/*", "lib/**/*"]
}
